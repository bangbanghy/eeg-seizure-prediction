    X_wearable.shape[0]
)

print(
    "Time points per window:",
    X_wearable.shape[1]
)

print(
    "Number of channels:",
    X_wearable.shape[2]
)

time = (
    np.arange(WINDOW_SIZE)
    / FS_TARGET
)

plt.figure(
    figsize=(12, 3)
)

plt.plot(
    time,
    X_eeg[0]
)

plt.title(
    "Example 5-second EEG Window"
)

plt.xlabel(
    "Time (s)"
)

plt.ylabel(
    "Normalized amplitude"
)

plt.show()


