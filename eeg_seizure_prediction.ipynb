# ============================================================
# 4. Automatically Match Biosignal Files
# ============================================================

def find_signal_file(files, keyword):

    matched = [
        f for f in files
        if keyword.lower()
        in os.path.basename(f).lower()
    ]

    if len(matched) == 0:

        raise FileNotFoundError(
            f"No EDF file containing "
            f"'{keyword}' was found."
        )

    return matched[0]


